<launch>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>
  <arg name="publish_tf" default=""/>
  <arg name="debug_images" default=""/>
  <arg name="tf_mode" default=""/>
  <arg name="odom_frame" default=""/>

  <node pkg="robot_localization" type="ekf_localization_node" name="agv_ekf_odom"
        output="screen">
    <rosparam command="load" file="$(find tag_nav_localization)/config/ekf_odom.yaml"/>
    <remap from="odometry/filtered" to="/agv/odometry/filtered"/>
  </node>

  <include file="$(find tag_nav_bringup)/launch/factory_gazebo.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
    <!-- The EKF below is the only publisher of odom -> base_footprint. -->
    <arg name="publish_odom_tf" value="false"/>
  </include>
  <include file="$(find tag_nav_localization)/launch/apriltag_localization.launch">
    <arg name="publish_tf" value="$(arg publish_tf)"/>
    <arg name="debug_images" value="$(arg debug_images)"/>
    <arg name="tf_mode" value="$(arg tf_mode)"/>
    <arg name="odom_frame" value="$(arg odom_frame)"/>
  </include>
</launch>
