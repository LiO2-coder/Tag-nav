material AprilTag/Atlas
{
  receive_shadows off

  technique
  {
    pass
    {
      lighting off
      depth_check on
      depth_write on
      cull_hardware none
      cull_software none

      texture_unit
      {
        texture apriltag_atlas.png
        filtering none
        tex_address_mode clamp
      }
    }
  }
}
