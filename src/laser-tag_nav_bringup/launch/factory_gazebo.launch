<?xml version="1.0"?>
<launch>
  <arg name="robot_name" default="warehouse_agv"/>
  <arg name="namespace" default="/agv"/>
  <arg name="publish_odom_tf" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="verbose" default="false"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <env
    name="GAZEBO_MODEL_PATH"
    value="$(find laser-tag_nav_bringup)/worlds/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find laser-tag_nav_description)/launch/gazebo.launch">
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="namespace" value="$(arg namespace)"/>
    <arg name="publish_odom_tf" value="$(arg publish_odom_tf)"/>
    <arg name="world_name" value="$(find laser-tag_nav_bringup)/worlds/factory.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="z" value="$(arg z)"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>
</launch>
