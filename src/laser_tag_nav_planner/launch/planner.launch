<launch>
  <!-- Same localization stack as factory_navigation.launch: the AprilTag node
       publishes map->odom, the EKF publishes odom->base_footprint, and the TF
       chain map->odom->base_footprint is the combined (EKF+tag) pose. -->
  <arg name="paused" default="false"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="$(arg gui)"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <!-- AprilTag localization + EKF + Gazebo. -->
  <include file="$(find laser_tag_nav_localization)/launch/factory_apriltag_localization.launch">
    <arg name="paused" value="$(arg paused)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="x" value="$(arg x)"/>
    <arg name="y" value="$(arg y)"/>
    <arg name="yaw" value="$(arg yaw)"/>
  </include>

  <!-- Static factory map so rviz has floor/wall context in the same map frame. -->
  <node pkg="map_server" type="map_server" name="map_server" output="screen"
        args="$(find laser-tag_nav_bringup)/maps/factory_map.yaml"/>

  <node pkg="laser_tag_nav_planner" type="laser_tag_nav_planner_node"
        name="laser_tag_nav_planner" output="screen">
    <rosparam command="load" file="$(find laser_tag_nav_planner)/config/planner.yaml"/>
    <remap from="cmd_vel" to="/agv/cmd_vel"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_planner" output="screen"
        args="-d $(find laser_tag_nav_planner)/config/tag_planner.rviz"/>
</launch>
